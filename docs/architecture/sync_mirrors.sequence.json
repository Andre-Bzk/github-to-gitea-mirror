  "cards": [
    {
      "dot": "cyan",
      "title": "Mirror ownership",
      "items": [
        "GitHub repositories drive the run; Gitea state is reconciled per repository",
        "Existing non-mirror repositories are warned about and left untouched",
        "Deleted or renamed upstream repositories are reported as orphaned mirrors"
      ]
    },
    {
      "dot": "orange",
      "title": "Release policy",
      "items": [
        "Release metadata is created or patched only when fields differ",
        "Draft handling waits until the mirrored tag exists in Gitea",
        "No Gitea-side release or asset is deleted by the script"
      ]
    },
    {
      "dot": "emerald",
      "title": "Asset streaming",
      "items": [
        "GitHub assets download in chunks into a temporary file",
        "Multipart upload streams the temporary file to Gitea",
        "Existing same-name assets are preserved, with size mismatch warnings"
      ]
    }
